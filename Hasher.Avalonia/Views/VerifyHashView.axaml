<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:vm="using:Hasher.Avalonia.ViewModels"
			 x:DataType="vm:VerifyHashViewModel"
             x:Class="Hasher.Avalonia.Views.VerifyHashView">
	<Grid RowDefinitions="Auto,Auto">
		<DockPanel Name="MenuPanel"
		   Grid.Row="0"
		   Margin="10,0,10,0">
			<ComboBox Name="cmbxAlgorithm"
					  Width="75"
					  VerticalAlignment="Center"
					  Margin="5,0,5,0"
					  DockPanel.Dock="Right"/>
			<ComboBox Name="cmbxBufferSize"
					  Width="75"
					  VerticalAlignment="Center"
					  Margin="5,0,5,0"
					  DockPanel.Dock="Right"/>
			<Button Name="btnCreate"
					Height="30"
					Width="75"
					Margin="5,0,5,0"
					VerticalAlignment="Center"
					HorizontalContentAlignment="Center"
					VerticalContentAlignment="Center"
					Content="Create"/>
			<Button Name="btnVerify"
					Height="30"
					Width="75"
					Margin="5,0,5,0"
					VerticalAlignment="Center"
					HorizontalContentAlignment="Center"
					VerticalContentAlignment="Center"
					Content="Verify"/>
			<Button Name="btnCancel"
					Height="30"
					Width="75"
					Margin="5,0,5,0"
					VerticalAlignment="Center"
					HorizontalContentAlignment="Center"
					VerticalContentAlignment="Center"
					Command="{Binding CancelCommand}"
					Content="Cancel"/>
		</DockPanel>
		<ListBox Grid.Row="1"></ListBox>
	</Grid>
</UserControl>
